---
import { company } from '../data/company';

const path = Astro.url.pathname;

const links = [
  { href: '/gnature', label: 'G Nature' },
  { href: '/sirca', label: 'Sirca' },
  { href: '/systems', label: 'Системы' },
  { href: '/knowledge', label: 'Знания' },
  { href: '/calc', label: 'Расчёт' },
  { href: '/contacts', label: 'Контакты' },
];

function current(href: string) {
  return path === href || (href !== '/' && path.startsWith(`${href}/`));
}
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="logo" href="/">
      <img class="logo-mark" src="/img/logo-gn.webp" alt="" width="36" height="36" />
      <span class="logo-stack">
        SIRCA.PRO
        <small>Каталог дилера · {company.legalNameShort}</small>
      </span>
    </a>
    <nav class="nav" aria-label="Основное">
      {
        links.map((l) => (
          <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <a class="header-phone" href={`tel:${company.phoneTel}`}>{company.phoneDisplay}</a>
  </div>
</header>
