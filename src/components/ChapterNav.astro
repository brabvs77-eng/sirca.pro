---
type Item = { href: string; label: string };
type Props = { items: Item[] };
const { items } = Astro.props;
const path = Astro.url.pathname;
---

<ul class="chips">
  {items.map((item) => (
    <li>
      <a class:list={[{ 'is-on': path === item.href }]} href={item.href}>
        {item.label}
      </a>
    </li>
  ))}
</ul>
