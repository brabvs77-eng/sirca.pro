---
import { company, offerDisclaimer } from '../data/company';
import { tasks } from '../data/tasks';
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="serif" style="font-size:1.6rem;margin:0 0 0.4rem;color:var(--sirca-gold-2)">sirca.pro</p>
      <p class="muted" style="color:#d8cfbf">
        Глянцевый каталог официального дилера Sirca и G Nature.<br />
        {company.legalNameShort}. Доставка: {company.delivery}. Склад не публикуем.
      </p>
      <p>
        <a href={`tel:${company.phoneTel}`}>{company.phoneDisplay}</a>
        · {company.director}<br />
        <a href={company.whatsapp}>WhatsApp</a>
      </p>
    </div>
    <div>
      <p class="eyebrow" style="color:var(--sirca-gold)">Главы</p>
      <p>
        {tasks.map((t, i) => (
          <>
            {i > 0 ? ' · ' : ''}
            <a href={`/tasks/${t.slug}`}>{t.title}</a>
          </>
        ))}
      </p>
    </div>
    <div>
      <p class="eyebrow" style="color:var(--sirca-gold)">Компания</p>
      <p>
        <a href="/requisites">Реквизиты</a><br />
        <a href="/delivery">Доставка</a><br />
        <a href="/privacy">Конфиденциальность</a><br />
        <a href="/contacts">Контакты</a>
      </p>
      <p class="muted" style="color:#d8cfbf;font-size:0.88rem">
        ИНН {company.inn} · КПП {company.kpp}
      </p>
    </div>
  </div>
  <div class="wrap footer-disclaimer">
    <strong>Не является офертой.</strong>
    {offerDisclaimer}
    Юридический адрес (не склад): {company.legalAddress}.
  </div>
</footer>
