---
interface Props {
  src: string;
  poster: string;
  title: string;
}

const { src, poster, title } = Astro.props;
---

<figure class="clip-wrap">
  <div class="reel-player">
    <video
      class="clip"
      poster={poster}
      preload="metadata"
      controls
      playsinline
      controlsList="nodownload nofullscreen"
    >
      <source src={src} type="video/mp4" />
    </video>
    <button type="button" class="reel-pip" aria-label={`${title}: картинка в картинке`} title="Картинка в картинке" hidden>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          fill="currentColor"
          d="M19 7h-8v6h8V7zm0-2a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h8zM5 17h6v2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h2v2H5v12z"
        />
      </svg>
    </button>
  </div>
  <figcaption>{title}</figcaption>
</figure>

<script>
  const togglePiP = async (video: HTMLVideoElement) => {
    if (!document.pictureInPictureEnabled) return;
    if (document.pictureInPictureElement === video) {
      await document.exitPictureInPicture();
      return;
    }
    await video.requestPictureInPicture();
  };

  document.querySelectorAll<HTMLButtonElement>('.reel-pip').forEach((btn) => {
    if (!document.pictureInPictureEnabled) return;
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const video = btn.closest('.reel-player')?.querySelector('video');
      if (video) void togglePiP(video);
    });
  });
</script>
