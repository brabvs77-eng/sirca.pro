---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company, offerDisclaimer } from '../data/company';

type Props = {
  title: string;
  description: string;
  canonical?: string;
  cover?: boolean;
};

const { title, description, canonical, cover = false } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, company.site).toString();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="sirca.pro" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/onest-400.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class:list={[{ 'has-cover': cover }]}>
    <a class="skip" href="#main">К содержанию</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <p class="legal-banner">
      <span class="wrap">{offerDisclaimer}</span>
    </p>
    <Footer />
    <nav class="bottom-nav" aria-label="Быстрые разделы">
      <a href="/gnature">G Nature</a>
      <a href="/sirca">Sirca</a>
      <a href="/calc">Расчёт</a>
      <a href="/contacts">Связь</a>
    </nav>
  </body>
</html>
