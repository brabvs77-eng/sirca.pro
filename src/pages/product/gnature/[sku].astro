---
import Base from '../../../layouts/Base.astro';
import { company, priceNote } from '../../../data/company';
import { gnPackImage } from '../../../data/media';
import { formatRub } from '../../../data/pricing';
import { gnBySlug, gnatureProducts, gnFromPrice } from '../../../data/products-gnature';
import { tasks } from '../../../data/tasks';
import ProductCard from '../../../components/ProductCard.astro';

export function getStaticPaths() {
  return gnatureProducts.map((p) => ({ params: { sku: p.slug } }));
}

const product = gnBySlug(Astro.params.sku!);
if (!product) throw new Error('not found');

const from = gnFromPrice(product);
const taskLinks = tasks.filter((t) => product.tasks.includes(t.slug));
const related = gnatureProducts.filter((p) => p.sku !== product.sku && p.use === product.use).slice(0, 3);
const img = gnPackImage(product.sku);
---

<Base
  title={`${product.sku} ${product.name} — G Nature, цена от ${formatRub(from)}`}
  description={`${product.name} (${product.nameDe}). ${product.short} Купить у дилера в Москве, доставка по России.`}
>
  <div class="wrap spread">
    <div>
      <p class="crumbs">
        <a href="/">Каталог</a> / <a href="/gnature">G Nature</a> / {product.sku}
      </p>
      <div class="spread-photo">
        {img ? (
          <img src={img} alt={`${product.sku} ${product.name}`} width="720" height="720" />
        ) : null}
      </div>
    </div>
    <div>
      <p class="eyebrow">G Nature · {product.nameDe}</p>
      <h1>{product.sku}<br />{product.name}</h1>
      <p class="price" style="font-size:2.1rem;margin-top:-0.35rem">от {formatRub(from)}</p>
      <p>{product.description}</p>
      <div class="specs">
        <div>
          <small>1 слой</small>
          <strong>{product.coverage1 ? `${product.coverage1} м²/л` : '—'}</strong>
        </div>
        <div>
          <small>2 слоя</small>
          <strong>{product.coverage2 ? `${product.coverage2} м²/л` : '—'}</strong>
        </div>
        <div>
          <small>сушка</small>
          <strong>{product.dry ?? '—'}</strong>
        </div>
      </div>
      <h2>Цены</h2>
      <table class="table">
        <thead>
          <tr>
            <th>Фасовка</th>
            <th>Цена</th>
            <th>Ориентир</th>
          </tr>
        </thead>
        <tbody>
          {product.packs.map((pack) => (
            <tr>
              <td>{pack.volume}</td>
              <td class="price">{formatRub(pack.price)}</td>
              <td class="muted">{formatRub(pack.marketPrice)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="muted" style="font-size:0.88rem">{priceNote}</p>
      {product.features.length > 0 && (
        <ul class="features">
          {product.features.map((f) => <li>{f}</li>)}
        </ul>
      )}
      {product.composition && <p><strong>Состав.</strong> {product.composition}</p>}
      {product.tinting && <p><strong>Колеровка:</strong> {product.tinting}</p>}
      {taskLinks.length > 0 && (
        <p>
          Главы: {taskLinks.map((t, i) => (
            <>
              {i > 0 ? ', ' : ''}
              <a href={`/tasks/${t.slug}`}>{t.title}</a>
            </>
          ))}
        </p>
      )}
      <p>
        <a class="btn btn-gn" href={`tel:${company.phoneTel}`}>Заказать {company.phoneDisplay}</a>
        <a class="btn btn-ghost" href="/calc/raskhod">Посчитать литры</a>
      </p>
    </div>
  </div>
  {related.length > 0 && (
    <div class="wrap" style="padding-bottom:3rem">
      <div class="chapter">
        <h2>На соседней странице</h2>
      </div>
      <div class="cards cols-3">
        {related.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  )}
</Base>
