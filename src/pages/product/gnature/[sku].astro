---
import Base from '../../../layouts/Base.astro';
import { company, priceNote } from '../../../data/company';
import { gnLifeImage, gnPackImage, gnPackShots, gnPoster, gnVideoSrc } from '../../../data/media';
import { formatRub } from '../../../data/pricing';
import { gnBySlug, gnatureProducts, gnFromPrice } from '../../../data/products-gnature';
import { systemsForSku } from '../../../data/systems';
import { tasks } from '../../../data/tasks';
import { vokrugCveta, prostoKosmos } from '../../../data/colors';
import ProductCard from '../../../components/ProductCard.astro';

export function getStaticPaths() {
  return gnatureProducts.map((p) => ({ params: { sku: p.slug } }));
}

const product = gnBySlug(Astro.params.sku!);
if (!product) throw new Error('not found');

const from = gnFromPrice(product);
const taskLinks = tasks.filter((t) => product.tasks.includes(t.slug));
const related = gnatureProducts.filter((p) => p.sku !== product.sku && p.use === product.use).slice(0, 3);
const img = gnPackImage(product.sku);
const life = gnLifeImage(product.sku);
const video = gnVideoSrc(product.sku);
const poster = gnPoster(product.sku);
const shots = gnPackShots(product.sku);
const cycles = systemsForSku(product.sku);
const colors =
  product.sku === '285' ? prostoKosmos.slice(0, 8) : product.tinting ? vokrugCveta.slice(0, 8) : [];
---

<Base
  title={`${product.sku} ${product.name} — G Nature, цена от ${formatRub(from)}`}
  description={`${product.name} (${product.nameDe}). ${product.short} Купить у дилера в Москве, доставка по России.`}
>
  {video && poster && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: `${product.sku} ${product.name}`,
      description: product.short,
      thumbnailUrl: `https://sirca.pro${poster}`,
      contentUrl: `https://sirca.pro${video}`,
    })} />
  )}
  <div class="wrap spread">
    <div>
      <p class="crumbs">
        <a href="/">Каталог</a> / <a href="/gnature">G Nature</a> / {product.sku}
      </p>
      <div class={`spread-photo${life ? ' life' : ''}`}>
        {life ? (
          <img src={life} alt={`${product.sku} ${product.name} на объекте`} width="1200" height="900" />
        ) : img ? (
          <img src={img} alt={`${product.sku} ${product.name}`} width="720" height="720" />
        ) : null}
      </div>
      {shots.length > 1 && (
        <div class="thumbs" aria-label="Фасовки">
          {shots.map((shot) => (
            <figure>
              <img src={shot.src} alt={`${product.sku}, ${shot.label}`} width="280" height="280" loading="lazy" />
              <figcaption>{shot.label}</figcaption>
            </figure>
          ))}
        </div>
      )}
      {video && (
        <video class="clip" poster={poster} preload="none" controls playsinline>
          <source src={video} type="video/mp4" />
        </video>
      )}
    </div>
    <div>
      <p class="eyebrow">G Nature · {product.nameDe}</p>
      <h1>{product.sku}<br />{product.name}</h1>
      <p class="price" style="font-size:2.1rem;margin-top:-0.35rem">от {formatRub(from)}</p>
      <p>{product.description}</p>
      <div class="specs">
        <div>
          <small>1 слой</small>
          <strong>{product.coverage1 ? `${product.coverage1} м²/л` : '—'}</strong>
        </div>
        <div>
          <small>2 слоя</small>
          <strong>{product.coverage2 ? `${product.coverage2} м²/л` : '—'}</strong>
        </div>
        <div>
          <small>сушка</small>
          <strong>{product.dry ?? '—'}</strong>
        </div>
      </div>
      <h2>Цены</h2>
      <table class="table">
        <thead>
          <tr>
            <th>Фасовка</th>
            <th>Цена</th>
            <th>Ориентир</th>
          </tr>
        </thead>
        <tbody>
          {product.packs.map((pack) => (
            <tr>
              <td>{pack.volume}</td>
              <td class="price">{formatRub(pack.price)}</td>
              <td class="muted">{formatRub(pack.marketPrice)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="muted" style="font-size:0.88rem">{priceNote}</p>
      {product.features.length > 0 && (
        <ul class="features">
          {product.features.map((f) => <li>{f}</li>)}
        </ul>
      )}
      {product.composition && <p><strong>Состав.</strong> {product.composition}</p>}
      {product.tinting && <p><strong>Колеровка:</strong> {product.tinting}</p>}
      {cycles.length > 0 && (
        <p>
          Системы: {cycles.map((s, i) => (
            <>
              {i > 0 ? ', ' : ''}
              <a href={`/systems#${s.id}`}>{s.title}</a>
            </>
          ))}
        </p>
      )}
      {taskLinks.length > 0 && (
        <p>
          Главы: {taskLinks.map((t, i) => (
            <>
              {i > 0 ? ', ' : ''}
              <a href={`/tasks/${t.slug}`}>{t.title}</a>
            </>
          ))}
        </p>
      )}
      <p>
        <a class="btn btn-gn" href={`tel:${company.phoneTel}`}>Заказать {company.phoneDisplay}</a>
        <a class="btn btn-ghost" href={`/calc/raskhod?sku=gn-${product.slug}`}>Посчитать литры</a>
      </p>
    </div>
  </div>
  {colors.length > 0 && (
    <div class="wrap">
      <div class="chapter">
        <h2>{product.sku === '285' ? 'Просто космос' : 'Вокруг цвета'}</h2>
        <a class="pg" href={product.sku === '285' ? '/colors/prosto-kosmos' : '/colors/vokrug-cveta'}>вся коллекция →</a>
      </div>
      <div class="rail-wrap">
        <div class="rail">
          {colors.map((c) => (
            <a class="swatch" href={`/colors/${c.slug}`}>
              <img src={c.img} alt={`G Nature, цвет ${c.name}`} width="320" height="240" loading="lazy" />
              <span>{c.n} {c.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}
  {related.length > 0 && (
    <div class="wrap" style="padding-bottom:3rem">
      <div class="chapter">
        <h2>На соседней странице</h2>
      </div>
      <div class="cards cols-3">
        {related.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  )}
</Base>
