---
import Base from '../../../layouts/Base.astro';
import { company, priceNote } from '../../../data/company';
import { covers } from '../../../data/media';
import { formatRub } from '../../../data/pricing';
import { sircaBySlug, sircaFromPrice, sircaProducts } from '../../../data/products-sirca';
import { tasks } from '../../../data/tasks';

export function getStaticPaths() {
  return sircaProducts.map((p) => ({ params: { sku: p.slug } }));
}

const product = sircaBySlug(Astro.params.sku!);
if (!product) throw new Error('not found');

const from = sircaFromPrice(product);
const taskLinks = tasks.filter((t) => product.tasks.includes(t.slug));
const chem =
  product.chemistry === 'water'
    ? 'вода'
    : product.chemistry === 'pu'
      ? 'полиуретан'
      : product.chemistry === 'acrylic'
        ? 'акрил'
        : 'масло';
---

<Base
  title={`${product.sku} — Sirca, цена от ${formatRub(from)}`}
  description={`${product.name}. ${product.short} Официальный дилер, доставка по Москве и России.`}
>
  <div class="wrap spread">
    <div class="spread-photo life">
      <img src={covers.sirca} alt="Sirca, деревянное домостроение" width="1400" height="900" />
    </div>
    <div>
      <p class="crumbs">
        <a href="/">Каталог</a> / <a href="/sirca">Sirca</a> / {product.sku}
      </p>
      <p class="eyebrow">Sirca · {chem}</p>
      <h1>{product.name}</h1>
      <p class="price" style="font-size:2.1rem;margin-top:-0.35rem">от {formatRub(from)}</p>
      <p>{product.description}</p>
      <div class="specs">
        <div>
          <small>химия</small>
          <strong>{chem}</strong>
        </div>
        <div>
          <small>учёт</small>
          <strong>за {product.unit}</strong>
        </div>
        <div>
          <small>раздел</small>
          <strong>{product.use === 'parquet' ? 'паркет' : product.use === 'windows' ? 'окна' : product.use === 'oils' ? 'масло' : product.use === 'furniture' ? 'мебель' : 'экстерьер'}</strong>
        </div>
      </div>
      <table class="table">
        <thead>
          <tr>
            <th>Фасовка</th>
            <th>Цена</th>
            <th>Ориентир</th>
          </tr>
        </thead>
        <tbody>
          {product.packs.map((pack) => (
            <tr>
              <td>{pack.volume}</td>
              <td class="price">{formatRub(pack.price)}</td>
              <td class="muted">{formatRub(pack.marketPrice)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="muted" style="font-size:0.88rem">
        {priceNote}
        {product.hardener ? ` Отвердитель: ${product.hardener}.` : ''}
      </p>
      <ul class="features">
        {product.features.map((f) => <li>{f}</li>)}
      </ul>
      {taskLinks.length > 0 && (
        <p>
          Главы: {taskLinks.map((t, i) => (
            <>
              {i > 0 ? ', ' : ''}
              <a href={`/tasks/${t.slug}`}>{t.title}</a>
            </>
          ))}
        </p>
      )}
      <p>
        <a class="btn btn-sirca" href={`tel:${company.phoneTel}`}>Заказать {company.phoneDisplay}</a>
        <a class="btn btn-ghost" href={company.whatsapp}>WhatsApp</a>
      </p>
    </div>
  </div>
</Base>
