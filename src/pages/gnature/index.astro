---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { gnatureProducts } from '../../data/products-gnature';

const groups = [
  { id: 'exterior', title: 'Наружные работы', items: gnatureProducts.filter((p) => p.use === 'exterior') },
  { id: 'interior', title: 'Внутренние работы', items: gnatureProducts.filter((p) => p.use === 'interior') },
  { id: 'care', title: 'Уход и грунт', items: gnatureProducts.filter((p) => p.use === 'care') },
  { id: 'tools', title: 'Кисти', items: gnatureProducts.filter((p) => p.use === 'tools') },
];
---

<Base
  title="G Nature (Gnature, Гнатур) — масла и краски для дерева | sirca.pro"
  description="Каталог G Nature: 280, 425, 460, 277, 245, 870. Цены ниже открытой витрины gnature.ru. Доставка по Москве и России."
>
  <div class="wrap" style="padding:2rem 0 3rem">
    <p class="crumbs"><a href="/">Главная</a> / G Nature</p>
    <p class="eyebrow">Gnature · Гнатур · Германия</p>
    <h1>G Nature — натуральные масла и краски</h1>
    <p>
      Официальная линейка: фасад, терраса, дом внутри, баня, пол, столешница.
      Цены на фасовки указаны. Колеровка RAL / NCS / фирменный веер.
    </p>
    <p>
      <a class="btn btn-gn" href="/calc/raskhod">Рассчитать расход</a>
      <a class="btn btn-ghost" href="/colors/vokrug-cveta">Вокруг цвета</a>
      <a class="btn btn-ghost" href="/colors/prosto-kosmos">Просто космос</a>
    </p>

    {groups.map((g) => (
      <section style="margin-top:2.2rem">
        <h2 id={g.id}>{g.title}</h2>
        <div class="cards cols-3">
          {g.items.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    ))}
  </div>
</Base>
