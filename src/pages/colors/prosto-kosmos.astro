---
import Base from '../../layouts/Base.astro';
import { covers } from '../../data/media';
import { prostoKosmos } from '../../data/colors';
---

<Base
  title="Просто космос — металлик 285 G Nature | sirca.pro"
  description="Коллекция металлик для масла 285 Fassadenöl. Живые выкрасы. Стабильность цвета до 10 лет."
>
  <div class="panel gn" style={`min-height:16rem;border-radius:0;background-image:url('${covers.gn}')`}>
    <div class="wrap" style="padding:4.2rem 0 1.4rem">
      <p class="eyebrow" style="color:#e8f5dc">285 Fassadenöl</p>
      <h1>Просто космос</h1>
      <p>Металлик-оттенки с рекламного каталога. Пигмент на выкрасе, не на экране.</p>
    </div>
  </div>
  <div class="wrap page-pad">
    <div class="cards cols-3">
      {prostoKosmos.map((c) => (
        <a class="product gn" href={`/colors/${c.slug}`}>
          <div class="shot color-shot">
            <img src={c.img} alt={`G Nature 285, цвет ${c.name}`} width="640" height="480" loading="lazy" />
          </div>
          <div class="body">
            <span class="brand">{c.n}</span>
            <h3>{c.name}</h3>
          </div>
        </a>
      ))}
    </div>
    <p style="margin-top:1.6rem">
      <a class="btn btn-gn" href="/product/gnature/285">Масло 285, цены</a>
      <a class="btn btn-ghost" href="/colors/vokrug-cveta">Вокруг цвета</a>
    </p>
  </div>
</Base>
