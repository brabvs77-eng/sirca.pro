---
import Base from '../../layouts/Base.astro';
import { covers } from '../../data/media';
import { vokrugCveta } from '../../data/colors';
---

<Base
  title="Коллекция «Вокруг цвета» G Nature | sirca.pro"
  description="20 интерьерных оттенков G Nature. Живые выкрасы. Колеровка 245, 475, 280, 425 у дилера."
>
  <div class="panel gn" style={`min-height:16rem;border-radius:0;background-image:url('${covers.family}')`}>
    <div class="wrap" style="padding:4.2rem 0 1.4rem">
      <p class="eyebrow" style="color:#e8f5dc">Коллекция · каталог А5</p>
      <h1>Вокруг цвета</h1>
      <p>Фирменный веер G Nature. На фото — реальный выкрас, не экранный свотч.</p>
    </div>
  </div>
  <div class="wrap page-pad">
    <div class="cards cols-4">
      {vokrugCveta.map((c) => (
        <a class="product gn" href={`/colors/${c.slug}`}>
          <div class="shot color-shot">
            <img src={c.img} alt={`G Nature, цвет ${c.name}`} width="640" height="480" loading="lazy" />
          </div>
          <div class="body">
            <span class="brand">{c.n}</span>
            <h3>{c.name}</h3>
          </div>
        </a>
      ))}
    </div>
    <p style="margin-top:1.6rem">
      <a class="btn btn-gn" href="/product/gnature/245">Твёрдое масло 245</a>
      <a class="btn btn-ghost" href="/product/gnature/280">Фасад 280</a>
      <a class="btn btn-ghost" href="/colors/prosto-kosmos">Просто космос</a>
    </p>
  </div>
</Base>
