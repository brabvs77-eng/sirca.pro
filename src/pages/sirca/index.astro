---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import { covers } from '../../data/media';
import { sircaChapterNav } from '../../data/nav';
import { groupSircaProducts } from '../../data/sirca-groups';
import { sircaProducts } from '../../data/products-sirca';

const sections = groupSircaProducts(sircaProducts);
---

<Base
  title="Каталог Sirca — ЛКМ для деревянного домостроения | sirca.pro"
  description="109 SKU Sirca: IMW4800, OWE, FWE, паркет, мебель. Доставка по Москве и России."
>
  <div class="panel sirca" style={`min-height:18rem;border-radius:0;background-image:url('${covers.sirca}')`}>
    <div class="wrap" style="padding:4.5rem 0 1.6rem">
      <p class="eyebrow" style="color:var(--sirca-gold)">Глава · Италия · домостроение</p>
      <h1>Sirca</h1>
      <p>{sircaProducts.length} позиций: водные системы домостроения, паркет, мебельные ПУ и акрил.</p>
    </div>
  </div>
  <div class="wrap page-pad">
    <ChapterNav items={sircaChapterNav} />
    <p class="note">
      Цена за 1 л или 1 кг. Отвердитель для ПУ — отдельной строкой. TDS — в
      <a href="/knowledge/sirca-specs">базе знаний</a>.
    </p>
    {sections.map((section, i) => (
      <section>
        <div class="chapter">
          <h2>
            {section.href ? (
              <a href={section.href} style="color:inherit;text-decoration:none">{section.label}</a>
            ) : (
              section.label
            )}
          </h2>
          <span class="pg">{String(i + 1).padStart(2, '0')}</span>
        </div>
        <div class="cards cols-3">
          {section.items.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    ))}
  </div>
</Base>
