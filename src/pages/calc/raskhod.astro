---
import Base from '../../layouts/Base.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import { calcMaterials } from '../../data/calc';
import { company } from '../../data/company';
import { calcNav } from '../../data/nav';
import { speciesCoeff } from '../../data/systems';

const options = calcMaterials;
const woods = speciesCoeff;
---

<Base
  title="Калькулятор расхода масла и краски | sirca.pro"
  description="Расчёт литров G Nature и Sirca: площадь, слои, коэффициент породы, фасовка и сумма. Не оферта."
>
  <div class="wrap page-pad">
    <p class="crumbs"><a href="/">Каталог</a> / <a href="/calc">Расчёт</a> / Литры</p>
    <h1>Сколько литров нужно</h1>
    <ChapterNav items={calcNav} />
    <p>
      G Nature: литры = площадь / расход_м² × слои × коэффициент породы.
      Sirca: мокрый слой 125 г/м², плотность 1,05. Округляем вверх.
    </p>

    <form class="calc" id="calc" style="max-width:36rem">
      <label>
        Материал
        <select name="sku" id="sku">
          {options.map((o) => (
            <option value={o.id}>{o.brand} {o.sku} — {o.name}</option>
          ))}
        </select>
      </label>
      <label>
        Площадь, м²
        <input type="number" name="area" id="area" min="1" step="0.1" value="80" />
      </label>
      <label>
        Слои
        <select name="coats" id="coats">
          <option value="1">1 слой</option>
          <option value="2" selected>2 слоя</option>
        </select>
      </label>
      <label>
        Поверхность / порода
        <select name="wood" id="wood">
          {woods.map((w) => (
            <option value={w.id}>{w.label} × {w.coeff}</option>
          ))}
        </select>
      </label>
      <div class="calc-out" id="out">Считаем…</div>
      <p>
        <button type="button" class="btn" id="share">Скопировать расчёт</button>
        <a class="btn btn-ghost" href={`tel:${company.phoneTel}`}>Подтвердить у менеджера</a>
        <a class="btn btn-ghost" href={company.whatsapp}>WhatsApp</a>
      </p>
    </form>
    <p class="muted" style="max-width:36rem">
      Не учитываем торцы сверх площади, потери на кисть и старое покрытие.
      Прикидка, не оферта и не смета.
    </p>
  </div>
</Base>

<script define:vars={{ options, woods }}>
  const form = document.getElementById('calc');
  const out = document.getElementById('out');
  const share = document.getElementById('share');
  const fmt = new Intl.NumberFormat('ru-RU');

  const q = new URLSearchParams(location.search);
  ['sku', 'area', 'coats', 'wood'].forEach((id) => {
    const el = document.getElementById(id);
    if (el && q.get(id)) el.value = q.get(id);
  });

  function bestPacks(liters, packs) {
    const sorted = [...packs].sort((a, b) => b.liters - a.liters);
    let left = liters;
    const pick = [];
    for (const pack of sorted) {
      const n = Math.floor(left / pack.liters + 1e-9);
      if (n > 0) {
        pick.push({ ...pack, n });
        left = +(left - n * pack.liters).toFixed(3);
      }
    }
    if (left > 0 && sorted.length) {
      const small = [...packs].sort((a, b) => a.liters - b.liters)[0];
      const extra = Math.ceil(left / small.liters);
      const found = pick.find((p) => p.liters === small.liters);
      if (found) found.n += extra;
      else pick.push({ ...small, n: extra });
    }
    return pick;
  }

  function litersOf(p, area, coats, coeff) {
    if (p.kind === 'wet') {
      const gsm = p.wetGsm || 125;
      const dens = p.density || 1.05;
      return (area * (gsm / 1000) / dens) * coats * coeff;
    }
    const cov = coats === 2 ? p.coverage2 : p.coverage1;
    return (area / cov) * coats * coeff;
  }

  function render() {
    const id = document.getElementById('sku').value;
    const area = Number(document.getElementById('area').value);
    const coats = Number(document.getElementById('coats').value);
    const woodId = document.getElementById('wood').value;
    const p = options.find((o) => o.id === id);
    const wood = woods.find((w) => w.id === woodId) || { coeff: 1, label: '' };
    if (!p || !area) {
      out.textContent = 'Укажите площадь.';
      return;
    }
    const raw = litersOf(p, area, coats, wood.coeff);
    const liters = Math.ceil(raw * 10) / 10;
    const pick = bestPacks(liters, p.packs);
    const sum = pick.reduce((s, x) => s + x.n * x.price, 0);
    const packs = pick.map((x) => `${x.n} × ${x.volume}`).join(', ');
    const note =
      p.kind === 'wet'
        ? `${p.wetGsm} г/м² мокрого слоя`
        : `${coats === 2 ? p.coverage2 : p.coverage1} м²/л`;
    out.innerHTML =
      `<strong>${liters.toLocaleString('ru-RU')} л</strong> · ${note} · ${wood.label}` +
      `<br>Банки: ${packs}` +
      `<br>Сумма ориентир: <span class="price">${fmt.format(sum)} ₽</span>` +
      `<br><a href="${p.href}">Карточка ${p.sku}</a>`;
    const next = new URLSearchParams({ sku: id, area: String(area), coats: String(coats), wood: woodId });
    history.replaceState(null, '', `${location.pathname}?${next}`);
  }

  form.addEventListener('input', render);
  share.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      share.textContent = 'Ссылка скопирована';
    } catch {
      share.textContent = 'Скопируйте адрес из строки';
    }
  });
  render();
</script>
